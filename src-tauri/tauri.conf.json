{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keyframe",
  "version": "0.1.1",
  "identifier": "com.keyframe.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "visible": false,
        "title": "Keyframe",
        "width": 1200,
        "height": 780,
        "minWidth": 980,
        "minHeight": 600,
        "dragDropEnabled": false,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "resources": { "resources/interception/*": "interception/" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
